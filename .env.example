# Uforge (You Forge) — environment variables

POSTGRES_USER=hforge
POSTGRES_PASSWORD=hforge
POSTGRES_DB=hforge

JWT_SECRET=dev-change-me-please
# Platform operator (role ADMIN: GET /v1/skills, no quota). Not the admin of an app.
BOOTSTRAP_ADMIN_EMAIL=admin@hforge.local

DATABASE_URL=postgresql://hforge:hforge@postgres:5432/hforge?schema=public
REDIS_URL=redis://redis:6379

HFORGE_SKILLS_DIR=/skills/prompt
HFORGE_SKILLS_MAX_CHARS=32000

GATEWAY_PORT=3000
# Every turn carries the whole workspace and the attached images.
GATEWAY_BODY_LIMIT=40mb
WEB_ORIGIN=http://localhost:5173

# Browser-side URLs (not the Docker hostnames).
VITE_GATEWAY_URL=http://localhost:3000
VITE_COMPILER_URL=http://localhost:3001

# AI (keys stay on the gateway, never in a .happ nor in the Runtime).
# anthropic | openai | stub. Unset: the first provider with a key, else stub.
AI_PROVIDER=stub

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Output budget: the AI writes complete files.
ANTHROPIC_MAX_TOKENS=64000
# low | medium | high | xhigh | max (empty to omit). Code generation wants high.
ANTHROPIC_EFFORT=high
# default = server-side fallback on a policy refusal; off to disable.
ANTHROPIC_FALLBACKS=default

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=
