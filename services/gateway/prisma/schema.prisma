generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The gateway is stateless about apps: no source, build, .happ or app data
// lives here. Only accounts, quotas and generation traces.

enum UserRole {
  USER
  ADMIN
}

enum PlanCode {
  FREE
  PRO
  BUSINESS
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  REFUSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  plan         PlanCode @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quota        PlanQuota?
  generations  Generation[]
  usageRecords UsageRecord[]
  auditLogs    AuditLog[]
}

model PlanQuota {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyGenerations Int      @default(5)
  dailyTokens      Int      @default(100000)
  monthlyTokens    Int      @default(500000)
  maxPromptChars   Int      @default(8000)
  maxContextChars  Int      @default(400000)
  maxFileBytes     Int      @default(10485760)
  maxBuildsPerDay  Int      @default(10)
  updatedAt        DateTime @updatedAt
}

model Generation {
  id               String           @id @default(uuid())
  requestId        String           @unique
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Id of the app on the device (header.appId). Plain text: apps are not stored here.
  appId            String?
  prompt           String
  skillsApplied    String[]
  skillsHash       String?
  provider         String?
  model            String?
  inputTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  estimatedCostUsd Float            @default(0)
  status           GenerationStatus @default(PENDING)
  /// Workspace paths written or deleted by this turn. Never the file contents.
  changedPaths     String[]         @default([])
  refusalReason    String?
  durationMs       Int?
  createdAt        DateTime         @default(now())
  usage            UsageRecord?
}

model UsageRecord {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId     String     @unique
  generation       Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  createdAt        DateTime   @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
}
